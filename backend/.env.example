# Base de datos (Neon) — connection string pooled (runtime) y directa (migraciones)
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/patero?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/patero?sslmode=require"

# Mercado Pago — access token de la cuenta de test/prod (Panel de Developers)
MP_ACCESS_TOKEN=

# Auth — secreto para firmar los JWT de sesión. Generar uno propio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Servidor
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
