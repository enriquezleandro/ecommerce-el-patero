// Prisma schema para "El Patero" (growshop). Los nombres de campo calcan
// exacto src/lib/types.ts del frontend para que el API devuelva objetos que
// los componentes ya consumen tal cual, sin capa de traducción.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductCategory {
  indoor
  parafernalia
  fertilizantes
  macetas
  indumentaria
}

model Product {
  id             String          @id @default(uuid())
  name           String
  category       ProductCategory
  price          Decimal         @db.Decimal(10, 2)
  originalPrice  Decimal?        @db.Decimal(10, 2)
  description    String
  specifications Json?
  images         String[]
  stock          Int             @default(0)
  isNew          Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  isOnSale       Boolean         @default(false)
  rating         Float?
  sizes          String[]
  colors         String[]
  reviews        Review[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([category])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  userName  String
  rating    Int
  comment   String
  date      DateTime @default(now())

  @@index([productId])
}

// Usuarios reales (antes mockeados en el AuthContext del frontend). La
// dirección y el medio de pago guardado se aplanan en columnas propias, igual
// que el resto del schema, y se re-anidan en el objeto `address` /
// `savedPaymentMethod` que espera src/lib/types.ts al serializar la respuesta.
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  street          String?
  city            String?
  province        String?
  postalCode      String?
  phone           String?
  paymentType     String?
  paymentLastFour String?
  isAdmin         Boolean  @default(false)
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot de los CartItem tal cual los define types.ts: guarda el producto
  // completo en el momento de la compra, no solo su id, para que el pedido
  // no cambie si el producto se edita o se borra después.
  items              Json
  total              Decimal     @db.Decimal(10, 2)
  status             OrderStatus @default(pending)
  shippingStreet     String
  shippingCity       String
  shippingProvince   String
  shippingPostalCode String
  shippingPhone      String
  paymentMethod      String
  createdAt          DateTime    @default(now())

  @@index([userId])
}
